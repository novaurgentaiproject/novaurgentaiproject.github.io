rules_version = '2';

// Nova accounts: each person can read and write only their own data
// (users/{their uid} and the chats under it). Paste this into
// Firebase console → Firestore Database → Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
